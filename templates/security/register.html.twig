<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <style>
        /* ── Webcam section ── */
        .face-section {
            margin-top: 24px;
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
        }
        .face-section-label {
            font-size: 13px; font-weight: 700; color: #7c3aed;
            letter-spacing: .5px; text-transform: uppercase; margin-bottom: 12px;
            display: flex; align-items: center; gap: 8px;
        }
        .face-section-label span { font-size: 11px; color: #94a3b8; font-weight: 400; text-transform: none; }

        .cam-wrapper {
            position: relative; border-radius: 16px; overflow: hidden;
            background: #0a0f1e; aspect-ratio: 4/3;
            border: 2px solid rgba(124,58,237,0.35);
            box-shadow: 0 0 28px rgba(124,58,237,0.15);
        }
        #regVideo {
            width: 100%; height: 100%; object-fit: cover; display: block;
            transform: scaleX(-1);
        }
        #regCanvas { display: none; }

        /* Corners */
        .vcorner { position: absolute; width: 22px; height: 22px; }
        .vcorner.tl { top:10px; left:10px; border-top:3px solid #7c3aed; border-left:3px solid #7c3aed; border-radius:4px 0 0 0;}
        .vcorner.tr { top:10px; right:10px; border-top:3px solid #7c3aed; border-right:3px solid #7c3aed; border-radius:0 4px 0 0;}
        .vcorner.bl { bottom:10px; left:10px; border-bottom:3px solid #7c3aed; border-left:3px solid #7c3aed; border-radius:0 0 0 4px;}
        .vcorner.br { bottom:10px; right:10px; border-bottom:3px solid #7c3aed; border-right:3px solid #7c3aed; border-radius:0 0 4px 0;}

        /* Captured preview */
        .cam-preview {
            display: none;
            border-radius: 16px; overflow: hidden;
            border: 2px solid #10b981;
            box-shadow: 0 0 20px rgba(16,185,129,0.25);
            aspect-ratio: 4/3; position: relative;
        }
        .cam-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cam-preview-badge {
            position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%);
            background: rgba(16,185,129,0.9); color: #fff;
            font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 99px;
        }

        .cam-controls { display: flex; gap: 10px; margin-top: 12px; }
        .btn-cam {
            flex: 1; padding: 11px; border: none; border-radius: 12px; cursor: pointer;
            font-size: 13px; font-weight: 700; font-family: 'Outfit', sans-serif;
            transition: opacity .2s, transform .1s;
        }
        .btn-cam:hover:not(:disabled) { opacity: .88; transform: translateY(-1px); }
        .btn-cam:disabled { opacity: .45; cursor: not-allowed; }
        .btn-cam-start  { background: linear-gradient(135deg,#7c3aed,#06b6d4); color: #fff; }
        .btn-cam-snap   { background: linear-gradient(135deg,#10b981,#059669); color: #fff; }
        .btn-cam-retake { background: #f1f5f9; color: #475569; }

        .cam-hint {
            font-size: 12px; color: #94a3b8; text-align: center; margin-top: 8px;
            line-height: 1.6;
        }
        .cam-hint.ok { color: #10b981; font-weight: 600; }
        .cam-hint.warn { color: #f59e0b; }

        .face-optional-note {
            background: #f0fdf4; border: 1px solid #bbf7d0;
            border-radius: 12px; padding: 12px 14px;
            font-size: 13px; color: #15803d; margin-top: 12px; line-height: 1.6;
        }
    </style>
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-bolt"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">Integrated Trading Workspace</p>
                <h1>Create your user account.</h1>
                <p class="auth-copy">
                    New registrations are created as standard user accounts and receive an empty wallet automatically.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-user"></i> Every self-created account is assigned the <code>USER</code> role.</div>
                    <div><i class="fas fa-wallet"></i> A wallet is created automatically so the account can log in immediately.</div>
                    <div><i class="fas fa-camera"></i> Optionally register your face to enable Face ID login.</div>
                </div>
            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Create Account</h2>
                <p class="auth-form-copy">Register a new user profile for the integrated project.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_register') }}" id="registerForm">
                    <div class="form-group">
                        <label>Full Name</label>
                        <div class="input-with-icon">
                            <i class="fas fa-user"></i>
                            <input type="text" name="full_name" value="{{ form_data.full_name }}" placeholder="Your full name">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="text" name="email" value="{{ form_data.email }}" placeholder="name@example.com">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" placeholder="At least 6 characters">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Confirm Password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-check-circle"></i>
                            <input type="password" name="confirm_password" placeholder="Repeat your password">
                        </div>
                    </div>

                    <!-- ── Google Account Link (optional) ── -->
                    <div style="border-top:1px solid #e2e8f0;padding-top:20px;margin-top:4px;">
                        <div style="font-size:13px;font-weight:700;color:#4285f4;letter-spacing:.5px;text-transform:uppercase;margin-bottom:12px;">
                            <i class="fas fa-link"></i> Link Google Account
                            <span style="font-size:11px;color:#94a3b8;font-weight:400;text-transform:none;">(optional — enables Google login)</span>
                        </div>

                        {% if google_linked %}
                        <!-- Already linked -->
                        <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:14px;background:#f0fdf4;border:1px solid #bbf7d0;">
                            <svg width="22" height="22" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                            <div>
                                <div style="font-weight:700;font-size:14px;color:#15803d;"><i class="fas fa-check-circle"></i> Google account linked</div>
                                <div style="font-size:12px;color:#166534;">{{ google_email }}</div>
                            </div>
                            <a href="{{ path('google_link_start') }}" style="margin-left:auto;font-size:12px;color:#64748b;text-decoration:underline;">Change</a>
                        </div>
                        {% else %}
                        <!-- Not yet linked -->
                        <a href="{{ path('google_link_start') }}" id="btn-link-google"
                           style="display:flex;align-items:center;justify-content:center;gap:10px;padding:13px 18px;border-radius:14px;border:1px solid #e2e8f0;background:#fff;color:#3c4043;font-weight:600;font-size:14px;text-decoration:none;font-family:'Outfit',sans-serif;transition:box-shadow .2s,transform .15s;"
                           onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.12)';this.style.transform='translateY(-1px)'"
                           onmouseout="this.style.boxShadow='none';this.style.transform='none'">
                            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                            Link a Google Account
                        </a>
                        <p style="font-size:12px;color:#94a3b8;margin-top:8px;text-align:center;">
                            You can still register without linking. Add it later from your profile.
                        </p>
                        {% endif %}
                    </div>

                    <!-- ── Face Photo (optional) ── -->
                    <div class="face-section">
                        <div class="face-section-label">
                            <i class="fas fa-camera"></i> Face Recognition Setup
                            <span>(optional — enables AI face login)</span>
                        </div>

                        <!-- Live camera -->
                        <div class="cam-wrapper" id="camWrapper">
                            <video id="regVideo" autoplay playsinline muted></video>
                            <canvas id="regCanvas"></canvas>
                            <div class="vcorner tl"></div>
                            <div class="vcorner tr"></div>
                            <div class="vcorner bl"></div>
                            <div class="vcorner br"></div>
                        </div>

                        <!-- Captured preview (shown after snap) -->
                        <div class="cam-preview" id="camPreview">
                            <img id="previewImg" src="" alt="Captured face">
                            <div class="cam-preview-badge"><i class="fas fa-check"></i> Face captured</div>
                        </div>

                        <div class="cam-controls">
                            <button type="button" class="btn-cam btn-cam-start" id="btnStartCam">
                                <i class="fas fa-video"></i> Start Camera
                            </button>
                            <button type="button" class="btn-cam btn-cam-snap" id="btnSnap" disabled>
                                <i class="fas fa-camera"></i> Capture Face
                            </button>
                            <button type="button" class="btn-cam btn-cam-retake" id="btnRetake" style="display:none;">
                                <i class="fas fa-redo"></i> Retake
                            </button>
                        </div>

                        <div class="cam-hint" id="camHint">
                            Click <strong>Start Camera</strong> then look straight at the camera and click <strong>Capture Face</strong>.
                        </div>

                        <div class="face-optional-note">
                            <i class="fas fa-info-circle"></i>
                            If you skip this step, you can still log in with your email &amp; password.
                            You can add a face photo later from your profile settings.
                        </div>

                        <!-- Hidden field sent with the form -->
                        <input type="hidden" name="face_image" id="faceImageInput">
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" style="margin-top:20px;">
                        Create Account
                    </button>
                </form>

                <div class="auth-switch">
                    Already have an account?
                    <a href="{{ path('app_login') }}">Sign in</a>
                </div>
            </div>
        </section>
    </main>

<script>
(function () {
    const btnStart   = document.getElementById('btnStartCam');
    const btnSnap    = document.getElementById('btnSnap');
    const btnRetake  = document.getElementById('btnRetake');
    const video      = document.getElementById('regVideo');
    const canvas     = document.getElementById('regCanvas');
    const camWrapper = document.getElementById('camWrapper');
    const preview    = document.getElementById('camPreview');
    const previewImg = document.getElementById('previewImg');
    const hint       = document.getElementById('camHint');
    const faceInput  = document.getElementById('faceImageInput');

    let stream = null;

    btnStart.addEventListener('click', async () => {
        try {
            stream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, facingMode: 'user' } });
            video.srcObject = stream;
            btnStart.disabled = true;
            btnSnap.disabled  = false;
            hint.textContent  = 'Look straight at the camera, then click Capture Face.';
        } catch (e) {
            hint.className = 'cam-hint warn';
            hint.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Camera access denied. You can still register without face recognition.';
        }
    });

    btnSnap.addEventListener('click', () => {
        canvas.width  = video.videoWidth  || 640;
        canvas.height = video.videoHeight || 480;
        const ctx = canvas.getContext('2d');
        // Un-mirror the capture so Face++ gets the correct orientation
        ctx.save();
        ctx.scale(-1, 1);
        ctx.drawImage(video, -canvas.width, 0, canvas.width, canvas.height);
        ctx.restore();

        const dataUrl = canvas.toDataURL('image/jpeg', 0.88);
        faceInput.value = dataUrl;

        // Show preview
        previewImg.src = dataUrl;
        camWrapper.style.display = 'none';
        preview.style.display    = 'block';
        btnSnap.style.display    = 'none';
        btnStart.style.display   = 'none';
        btnRetake.style.display  = 'flex';

        hint.className  = 'cam-hint ok';
        hint.innerHTML  = '<i class="fas fa-check-circle"></i> Face captured! You can retake or submit the form.';

        // Stop stream
        if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
    });

    btnRetake.addEventListener('click', () => {
        faceInput.value = '';
        previewImg.src  = '';
        preview.style.display    = 'none';
        camWrapper.style.display = 'block';
        btnRetake.style.display  = 'none';
        btnStart.style.display   = 'flex';
        btnStart.disabled        = false;
        btnSnap.style.display    = 'flex';
        btnSnap.disabled         = true;
        hint.className  = 'cam-hint';
        hint.innerHTML  = 'Click <strong>Start Camera</strong> then look straight at the camera and click <strong>Capture Face</strong>.';
    });
})();
</script>
</body>
</html>
