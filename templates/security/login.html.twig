<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-bolt"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">Integrated Trading Workspace</p>
                <h1>Login to access your portfolio environment.</h1>
                <p class="auth-copy">
                    Use your project account to access wallets, assets, portfolios, orders, contracts, and reputation data.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-shield-alt"></i> Admin accounts reach full management tools.</div>
                    <div><i class="fas fa-wallet"></i> User accounts open the wallet linked to that profile.</div>
                </div>

            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Sign In</h2>
                <p class="auth-form-copy">Database-backed login for the integrated project.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="text" name="email" value="{{ last_email }}" autocomplete="email" placeholder="name@example.com">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" autocomplete="current-password" placeholder="Enter your password">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Login</button>
                </form>

                <div class="auth-switch">
                    No account yet?
                    <a href="{{ path('app_register') }}">Create one</a>
                </div>

                <div class="auth-demo">
                    <h3>Seeded accounts</h3>
                    <p><strong>Admin:</strong> admin@nexora.tn / admin123</p>
                    <p><strong>User:</strong> ayoub1@nexora.tn / user123</p>
                    <p><strong>User:</strong> test1@nexora.tn / user456</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Giant Interactive Background Icon -->
    <div class="wallet-background-wrapper">
        <div class="wallet-interactive-zone">
            <div class="wallet-3d-wrap" id="walletWrap">
                <svg class="wallet-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <radialGradient id="walletGlow" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
                            <stop offset="0%" style="stop-color:var(--accent);stop-opacity:0.3" />
                            <stop offset="100%" style="stop-color:var(--accent);stop-opacity:0" />
                        </radialGradient>
                        <linearGradient id="walletBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#334155" />
                            <stop offset="100%" style="stop-color:#1e293b" />
                        </linearGradient>
                    </defs>
                    <circle cx="100" cy="100" r="80" fill="url(#walletGlow)" />
                    <rect x="40" y="70" width="120" height="80" rx="12" fill="url(#walletBodyGrad)" stroke="var(--accent)" stroke-width="0.5" />
                    <rect x="40" y="90" width="120" height="60" rx="12" fill="rgba(255, 255, 255, 0.05)" stroke="rgba(255, 255, 255, 0.1)" stroke-width="0.5" />
                    <path d="M40 70 L100 110 L160 70" fill="none" stroke="var(--accent)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"/>
                    <circle cx="140" cy="65" r="15" fill="#fbbf24" stroke="#d97706" stroke-width="0.5" opacity="0.5">
                        <animateTransform attributeName="transform" type="translate" values="0 0; 0 -5; 0 0" dur="3s" repeatCount="indefinite" />
                    </circle>
                    <text x="135" y="70" font-family="Outfit" font-size="12" font-weight="bold" fill="#d97706" opacity="0.5">N</text>
                </svg>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('mousemove', (e) => {
            const wrap = document.getElementById('walletWrap');
            if (!wrap) return;

            const { clientX, clientY } = e;
            const { innerWidth, innerHeight } = window;

            // Amplitude modérée pour un effet cinématique (icon géante)
            const rotateY = ((clientX / innerWidth) - 0.5) * 50;
            const rotateX = ((clientY / innerHeight) - 0.5) * -50;

            const moveX = ((clientX / innerWidth) - 0.5) * 30;
            const moveY = ((clientY / innerHeight) - 0.5) * 30;

            wrap.style.setProperty('--rx', `${rotateX}deg`);
            wrap.style.setProperty('--ry', `${rotateY}deg`);
            wrap.style.setProperty('--mx', `${moveX}px`);
            wrap.style.setProperty('--my', `${moveY}px`);
        });
    </script>
</body>
</html>
