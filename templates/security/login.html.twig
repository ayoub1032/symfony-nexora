<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-bolt"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">Integrated Trading Workspace</p>
                <h1>Login to access your portfolio environment.</h1>
                <p class="auth-copy">
                    Use your project account to access wallets, assets, portfolios, orders, contracts, and reputation data.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-shield-alt"></i> Admin accounts reach full management tools.</div>
                    <div><i class="fas fa-wallet"></i> User accounts open the wallet linked to that profile.</div>
                </div>
            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Sign In</h2>
                <p class="auth-form-copy">Database-backed login for the integrated project.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="text" name="email" value="{{ last_email }}" autocomplete="email" placeholder="name@example.com">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" autocomplete="current-password" placeholder="Enter your password">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Login</button>
                </form>

                <div style="display:flex;align-items:center;gap:12px;color:#94a3b8;font-size:13px;margin:16px 0;">
                    <span style="flex:1;height:1px;background:#e2e8f0;"></span>or continue with<span style="flex:1;height:1px;background:#e2e8f0;"></span>
                </div>

                <div style="display:flex;gap:10px;">
                    <a href="{{ path('google_login_start') }}" id="btn-google-login"
                       style="flex:1;display:flex;align-items:center;justify-content:center;gap:10px;padding:13px 18px;border-radius:14px;border:1px solid #e2e8f0;background:#fff;color:#3c4043;font-weight:600;font-size:14px;text-decoration:none;font-family:'Outfit',sans-serif;transition:box-shadow .2s,transform .15s;"
                       onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.12)';this.style.transform='translateY(-1px)'"
                       onmouseout="this.style.boxShadow='none';this.style.transform='none'">
                        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
                        Continue with Google
                    </a>
                    <a href="{{ path('app_face_login') }}" id="btn-face-login-small"
                       style="display:flex;align-items:center;justify-content:center;gap:8px;padding:13px 16px;border-radius:14px;background:linear-gradient(135deg,#7c3aed,#06b6d4);color:#fff;font-weight:600;font-size:13px;text-decoration:none;white-space:nowrap;transition:opacity .2s;"
                       onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                        <i class="fas fa-camera"></i> Face ID
                    </a>
                </div>

                <div class="auth-links-row auth-links-row-center">
                    <a href="{{ path('app_forgot_password') }}">Forgot password?</a>
                </div>

                <div style="display:flex;align-items:center;gap:12px;color:#94a3b8;font-size:13px;margin:16px 0;">
                    <span style="flex:1;height:1px;background:#e2e8f0;"></span>or<span style="flex:1;height:1px;background:#e2e8f0;"></span>
                </div>

                <a href="{{ path('app_face_login') }}" class="btn btn-primary btn-block" id="btn-face-login"
                   style="display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#7c3aed,#06b6d4);text-decoration:none;">
                    <i class="fas fa-camera"></i> Login with Face Recognition
                </a>

                <div class="auth-switch">
                    No account yet?
                    <a href="{{ path('app_register') }}">Create one</a>
                </div>

                <div class="auth-demo">
                    <h3>Seeded accounts</h3>
                    <p><strong>Admin:</strong> admin@nexora.tn / admin123</p>
                    <p><strong>User:</strong> ayoub1@nexora.tn / user123</p>
                    <p><strong>User:</strong> test1@nexora.tn / user456</p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
