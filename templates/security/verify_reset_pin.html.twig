<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Reset PIN - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-key"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">PIN Verification</p>
                <h1>Confirm the reset code from your email.</h1>
                <p class="auth-copy">
                    Enter the email address and the 6-digit PIN you received to unlock the password reset step.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-hashtag"></i> Only numeric 6-digit PIN codes are accepted.</div>
                    <div><i class="fas fa-hourglass-half"></i> If the code expires, request another one.</div>
                </div>
            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Verify PIN</h2>
                <p class="auth-form-copy">Validate the recovery code before choosing a new password.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_verify_reset_pin') }}">
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="text" name="email" value="{{ email }}" autocomplete="email" placeholder="name@example.com">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Reset PIN</label>
                        <div class="input-with-icon">
                            <i class="fas fa-key"></i>
                            <input type="text" name="pin" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit code">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Verify PIN</button>
                </form>

                <div class="auth-links-row">
                    <a href="{{ path('app_forgot_password', { email: email }) }}">Resend code</a>
                    <a href="{{ path('app_login') }}">Back to login</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
