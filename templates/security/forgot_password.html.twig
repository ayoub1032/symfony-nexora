<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-unlock-keyhole"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">Password Recovery</p>
                <h1>Request a reset PIN for your account.</h1>
                <p class="auth-copy">
                    Enter your email address and Nexora will send a 6-digit code that lets you reset your password.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-envelope"></i> The reset PIN is delivered to the account email.</div>
                    <div><i class="fas fa-clock"></i> Each PIN expires after 15 minutes.</div>
                </div>
            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Forgot Password</h2>
                <p class="auth-form-copy">Request a one-time PIN to reset your Nexora password.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_forgot_password') }}">
                    <div class="form-group">
                        <label>Email</label>
                        <div class="input-with-icon">
                            <i class="fas fa-envelope"></i>
                            <input type="text" name="email" value="{{ email }}" autocomplete="email" placeholder="name@example.com">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Send Reset PIN</button>
                </form>

                <div class="auth-switch">
                    Remembered your password?
                    <a href="{{ path('app_login') }}">Back to login</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
