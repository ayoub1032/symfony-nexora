<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Nexora</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-logo">
                    <span class="auth-logo-box"><i class="fas fa-shield-halved"></i></span>
                    <span>NEXORA</span>
                </div>
                <p class="auth-kicker">New Password</p>
                <h1>Choose a new password for your account.</h1>
                <p class="auth-copy">
                    The PIN has already been verified for <strong>{{ email }}</strong>. Set a new password, then sign in again.
                </p>
                <div class="auth-hints">
                    <div><i class="fas fa-lock"></i> Use at least 6 characters.</div>
                    <div><i class="fas fa-right-to-bracket"></i> After saving, return to the login page with the new password.</div>
                </div>
            </div>
        </section>

        <section class="auth-panel auth-form-panel">
            <div class="auth-form-card">
                <h2>Reset Password</h2>
                <p class="auth-form-copy">Finalize the password recovery flow.</p>

                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="auth-flash auth-flash-{{ label == 'danger' ? 'danger' : 'info' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <form method="post" action="{{ path('app_reset_password') }}">
                    <div class="form-group">
                        <label>New password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" autocomplete="new-password" placeholder="Enter your new password">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Confirm password</label>
                        <div class="input-with-icon">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="confirm_password" autocomplete="new-password" placeholder="Repeat your new password">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">Save New Password</button>
                </form>

                <div class="auth-switch">
                    Want to restart the flow?
                    <a href="{{ path('app_forgot_password') }}">Request another PIN</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
