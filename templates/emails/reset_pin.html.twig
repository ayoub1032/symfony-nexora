<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexora – Password Reset</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#0d0f1a;font-family:'Segoe UI',Arial,sans-serif;color:#0f172a;">

<!-- Outer wrapper -->
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
       style="background:linear-gradient(160deg,#0d0f1a 0%,#111827 50%,#0a1628 100%);padding:40px 16px;">
    <tr>
        <td align="center">

            <!-- Email card -->
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                   style="max-width:600px;border-radius:24px;overflow:hidden;box-shadow:0 32px 80px rgba(0,0,0,0.6);">

                <!-- ═══ HEADER ═══ -->
                <tr>
                    <td style="padding:0;background:linear-gradient(135deg,#1a1040 0%,#2d1b69 40%,#0e7490 100%);position:relative;">
                        <!-- Top accent line -->
                        <div style="height:3px;background:linear-gradient(90deg,#7c3aed,#06b6d4,#10b981);"></div>

                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                                <td style="padding:40px 44px 36px 44px;">

                                    <!-- Logo row -->
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                        <tr>
                                            <td style="background:rgba(255,255,255,0.12);border-radius:12px;padding:10px 18px;border:1px solid rgba(255,255,255,0.18);">
                                                <span style="font-size:20px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;">
                                                    &#9670;&nbsp;Nexora
                                                </span>
                                            </td>
                                        </tr>
                                    </table>

                                    <!-- Heading -->
                                    <div style="margin-top:28px;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:rgba(167,139,250,0.9);font-weight:600;">
                                        Security Alert
                                    </div>
                                    <div style="margin-top:10px;font-size:32px;line-height:1.2;font-weight:800;color:#ffffff;max-width:380px;">
                                        Reset your<br>password
                                    </div>
                                    <div style="margin-top:14px;font-size:15px;line-height:1.7;color:rgba(203,213,225,0.85);max-width:420px;">
                                        We received a request to reset the password on your Nexora account. Use the code below to proceed.
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- ═══ BODY ═══ -->
                <tr>
                    <td style="background:#ffffff;padding:40px 44px 32px 44px;">

                        <!-- Greeting -->
                        <div style="font-size:17px;color:#1e293b;line-height:1.6;">
                            Hello, <strong>{{ user.fullName|default('User') }}</strong> 👋
                        </div>
                        <div style="margin-top:8px;font-size:15px;color:#64748b;line-height:1.7;">
                            Here is your one-time 6-digit reset PIN:
                        </div>

                        <!-- PIN box -->
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                               style="margin:28px 0;">
                            <tr>
                                <td align="center"
                                    style="background:linear-gradient(135deg,#f5f3ff 0%,#eff6ff 50%,#f0fdfa 100%);
                                           border-radius:20px;
                                           border:2px solid #c4b5fd;
                                           padding:32px 24px;">

                                    <div style="font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#7c3aed;font-weight:700;margin-bottom:16px;">
                                        Your Reset PIN
                                    </div>

                                    <!-- Individual digit boxes -->
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;">
                                        <tr>
                                            {% for digit in pin|split('') %}
                                            <td style="padding:0 5px;">
                                                <div style="width:48px;height:64px;line-height:64px;text-align:center;
                                                            background:#ffffff;border-radius:12px;
                                                            border:2px solid #ddd6fe;
                                                            font-size:32px;font-weight:800;color:#1d4ed8;
                                                            box-shadow:0 4px 12px rgba(124,58,237,0.15);">
                                                    {{ digit }}
                                                </div>
                                            </td>
                                            {% endfor %}
                                        </tr>
                                    </table>

                                    <div style="margin-top:20px;font-size:13px;color:#7c3aed;font-weight:600;">
                                        ⏱ &nbsp;Expires in {{ expires_in_minutes }} minutes
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Info box -->
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                               style="margin-bottom:24px;">
                            <tr>
                                <td style="background:#fff7ed;border-radius:14px;border-left:4px solid #f59e0b;padding:18px 20px;">
                                    <div style="font-size:13px;font-weight:700;color:#92400e;margin-bottom:6px;">
                                        ⚠ &nbsp;Didn't request this?
                                    </div>
                                    <div style="font-size:13px;color:#78350f;line-height:1.7;">
                                        If you did not request a password reset, please ignore this email.
                                        Your account remains safe and no changes have been made.
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Steps hint -->
                        <div style="font-size:14px;color:#475569;line-height:1.8;">
                            <strong style="color:#1e293b;">How to use:</strong><br>
                            1. Go back to the Nexora reset page<br>
                            2. Enter the 6-digit PIN above<br>
                            3. Create your new password
                        </div>
                    </td>
                </tr>

                <!-- ═══ FOOTER ═══ -->
                <tr>
                    <td style="background:#0f172a;padding:28px 44px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                                <td>
                                    <span style="font-size:16px;font-weight:800;color:#ffffff;letter-spacing:-0.5px;">
                                        &#9670;&nbsp;Nexora
                                    </span>
                                    <div style="margin-top:8px;font-size:12px;color:#64748b;line-height:1.8;">
                                        This is an automated security email. Please do not reply.<br>
                                        &copy; {{ "now"|date("Y") }} Nexora. All rights reserved.
                                    </div>
                                </td>
                                <td align="right" valign="middle">
                                    <div style="width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#06b6d4);
                                                text-align:center;line-height:40px;font-size:18px;color:#fff;">
                                        🔐
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

            </table>
            <!-- / Email card -->

        </td>
    </tr>
</table>

</body>
</html>
