<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexora Password Reset PIN</title>
</head>
<body style="margin:0;padding:0;background-color:#eef2ff;font-family:Arial,sans-serif;color:#0f172a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:linear-gradient(180deg,#e0e7ff 0%,#eef2ff 100%);margin:0;padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#ffffff;border-radius:24px;overflow:hidden;box-shadow:0 18px 50px rgba(15,23,42,0.14);">
                    <tr>
                        <td style="padding:28px 36px;background:linear-gradient(135deg,#1e1b4b 0%,#312e81 45%,#0f766e 100%);color:#ffffff;">
                            <div style="font-size:13px;letter-spacing:2px;text-transform:uppercase;opacity:0.82;margin-bottom:12px;">Nexora Security</div>
                            <div style="font-size:34px;line-height:1.15;font-weight:700;max-width:420px;">Your password reset PIN is ready.</div>
                            <div style="margin-top:14px;font-size:15px;line-height:1.7;color:rgba(255,255,255,0.86);">
                                Use the verification code below to continue the password reset process for your Nexora account.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:32px 36px 10px 36px;">
                            <div style="font-size:16px;line-height:1.7;color:#334155;">
                                Hello {{ user.fullName|default('User') }},
                            </div>
                            <div style="margin-top:12px;font-size:16px;line-height:1.8;color:#334155;">
                                We received a request to reset the password for your Nexora account. Enter this 6-digit PIN in the app:
                            </div>
                            <div style="margin:26px 0 24px 0;padding:22px 24px;border-radius:20px;background:linear-gradient(135deg,#eef2ff 0%,#ecfeff 100%);border:1px solid #c7d2fe;text-align:center;">
                                <div style="font-size:12px;text-transform:uppercase;letter-spacing:2px;color:#475569;margin-bottom:12px;">Reset PIN</div>
                                <div style="font-size:36px;line-height:1;font-weight:700;letter-spacing:10px;color:#1d4ed8;">{{ pin }}</div>
                            </div>
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 20px 0;">
                                <tr>
                                    <td style="padding:18px 20px;border-radius:18px;background:#f8fafc;border:1px solid #e2e8f0;">
                                        <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:8px;">Important</div>
                                        <div style="font-size:14px;line-height:1.8;color:#475569;">This PIN expires in {{ expires_in_minutes }} minutes.</div>
                                        <div style="font-size:14px;line-height:1.8;color:#475569;">If you did not request a password reset, you can ignore this message.</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 36px 32px 36px;">
                            <div style="font-size:13px;line-height:1.8;color:#64748b;border-top:1px solid #e2e8f0;padding-top:18px;">
                                Sent by Nexora Support for account recovery. This email was generated automatically.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
