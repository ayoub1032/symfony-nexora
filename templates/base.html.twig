<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Nexora Wallet{% endblock %}</title>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {{ importmap('app') }}
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-dark text-light">
        <div class="app-container">
            <aside class="sidebar">
                <div class="logo">
                    <div class="logo-box">
                        <i class="fas fa-bolt logo-icon"></i>
                    </div>
                    <span>NEXORA</span>
                </div>
                <nav class="nav-menu">
                    <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}" style="background: linear-gradient(90deg, rgba(168, 85, 247, 0.1), transparent); border-left: 3px solid #a855f7; margin-bottom: 5px;">
                        <i class="fas fa-crown" style="color: #d8b4fe;"></i> 
                        Executive View
                    </a>
                    <a href="{{ path('wallet_index') }}" class="nav-link {% if app.request.attributes.get('_route') == 'wallet_index' %}active{% endif %}">
                        <i class="fas fa-th-large"></i> 
                        {{ app.session.get('role') == 'ADMIN' ? 'Global Dashboard' : 'My Dashboard' }}
                    </a>
                    <a href="{{ path('wallet_goal_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'wallet_goal' %}active{% endif %}">
                        <i class="fas fa-bullseye"></i> 
                        {{ app.session.get('role') == 'ADMIN' ? 'Trading Watchlist' : 'My Trading Goals' }}
                    </a>
                    <a href="{{ path('asset_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'asset' %}active{% endif %}">
                        <i class="fas fa-chart-line"></i> 
                        Assets
                    </a>
                    <a href="{{ path('portfolio_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'portfolio' %}active{% endif %}">
                        <i class="fas fa-briefcase"></i> 
                        Portfolios
                    </a>
                    <a href="{{ path('order_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'order' %}active{% endif %}">
                        <i class="fas fa-shopping-cart"></i> 
                        Orders
                    </a>
                    <a href="{{ path('p2p_contract_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'p2p_contract' %}active{% endif %}">
                        <i class="fas fa-handshake"></i> 
                        P2P Contracts
                    </a>
                    <a href="{{ path('user_reputation_index') }}" class="nav-link {% if app.request.attributes.get('_route') starts with 'user_reputation' %}active{% endif %}">
                        <i class="fas fa-star"></i> 
                        User Reputations
                    </a>
                    {% if app.session.get('role') == 'ADMIN' %}
                    <a href="{{ path('user_index') }}" class="nav-link {% if app.request.attributes.get('_route') in ['user_index', 'user_create', 'user_update', 'user_delete'] %}active{% endif %}">
                        <i class="fas fa-users"></i>
                        Users
                    </a>
                    {% endif %}
                    
                    <div style="margin-top: auto; padding-top: 2rem;">
                        <a href="{{ path('app_logout') }}" class="nav-link" style="color: #ef4444;">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </nav>
                <div class="sidebar-footer">
                    <p>© 2026 Nexora v3.0</p>
                </div>
            </aside>

            <main class="main-content">
                <header class="top-bar">
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search data...">
                    </div>
                    <div class="header-actions">
                        <button id="theme-toggle" class="theme-toggle" title="Toggle Light/Dark Mode">
                            <i class="fas fa-moon moon-icon"></i>
                            <i class="fas fa-sun sun-icon"></i>
                        </button>
                        {{ render(controller('App\\Controller\\NotificationController::renderHeader')) }}
                        <div class="user-profile">
                            <div class="user-info">
                                <span class="user-name">{{ app.session.get('user_name', 'Guest') }}</span>
                                <span class="user-role">{{ app.session.get('role', 'VISITOR') }}</span>
                            </div>
                            <img src="https://ui-avatars.com/api/?name={{ app.session.get('user_name', 'Guest') }}&background={{ app.session.get('role') == 'ADMIN' ? '6366f1' : '10b981' }}&color=fff" alt="Avatar">
                        </div>
                    </div>
                </header>

                <div class="content-wrapper">
                    {% block body %}{% endblock %}
                </div>
            </main>
        </div>

        {# Flash Message Modal #}
        {% set flashes = app.flashes %}
        {% if flashes is not empty %}
        <div id="flashModal" class="custom-modal" style="display: block; z-index: 9999;">
            <div class="modal-content glass animate-pop">
                <div class="modal-header">
                    <h2 class="d-flex align-items-center">
                        {% for label, messages in flashes %}
                            {% if label == 'congrats' %}
                                <i class="fas fa-trophy text-warning mr-3" style="font-size: 40px; filter: drop-shadow(0 0 10px #f59e0b);"></i>
                                <span class="text-warning">CONGRATULATIONS!</span>
                            {% else %}
                                <i class="fas {{ label == 'success' ? 'fa-check-circle text-success' : 'fa-exclamation-circle text-danger' }} mr-2"></i>
                                {{ label|capitalize }}
                            {% endif %}
                        {% endfor %}
                    </h2>
                    <span class="close-btn" onclick="document.getElementById('flashModal').style.display='none'">&times;</span>
                </div>
                <div class="modal-body py-4">
                    {% for label, messages in flashes %}
                        {% for message in messages %}
                            <p class="h5 mb-2">{{ message }}</p>
                        {% endfor %}
                    {% endfor %}
                </div>
                <div class="modal-footer">
                    {% set labels = flashes|keys %}
                    <button class="btn {{ 'congrats' in labels ? 'btn-warning' : 'btn-primary' }} btn-block" onclick="document.getElementById('flashModal').style.display='none'">
                        {{ 'congrats' in labels ? 'Amazing!' : 'Understood' }}
                    </button>
                </div>
            </div>
        </div>
        {% endif %}

        {% block javascripts %}
        <script>
        // --- Theme Management ---
        const themeToggle = document.getElementById('theme-toggle');
        const body = document.body;
        
        // Initialize Theme
        const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (currentTheme === 'light') {
            body.classList.add('light-mode');
        }
        
        themeToggle.addEventListener('click', () => {
            body.classList.toggle('light-mode');
            const theme = body.classList.contains('light-mode') ? 'light' : 'dark';
            localStorage.setItem('theme', theme);
        });

        document.addEventListener('DOMContentLoaded', function() {
            // 1. GLOBAL SEARCH
            const searchInput = document.querySelector('.search-bar input');
            if(searchInput) {
                searchInput.addEventListener('input', function() {
                    const filter = this.value.toLowerCase();
                    const tables = document.querySelectorAll('.data-table');
                    
                    tables.forEach(table => {
                        const rows = table.querySelectorAll('tbody tr');
                        rows.forEach(row => {
                            if(row.querySelector('.empty-state')) return;
                            const text = row.textContent.toLowerCase();
                            row.style.display = text.includes(filter) ? '' : 'none';
                        });
                    });
                });
            }

            // 2. TABLE SORTING (Tri)
            // GLOBAL SORT SETUP: any table with class="data-table" becomes sortable, including the user table.
            const tables = document.querySelectorAll('.data-table');
            tables.forEach(table => {
                const headers = table.querySelectorAll('thead th');
                headers.forEach((header, index) => {
                    const headerText = header.textContent.trim().toLowerCase();
                    // ACTIONS COLUMN IS SKIPPED: action buttons should not be sorted.
                    if(headerText === 'actions') return;
                    
                    // MAKE EACH HEADER LOOK CLICKABLE AND ADD A SORT ICON IF MISSING.
                    header.style.cursor = 'pointer';
                    header.title = "Click to sort";
                    
                    if(!header.querySelector('i')){
                        header.innerHTML += ' <i class="fas fa-sort text-muted" style="font-size: 0.8em; margin-left: 5px;"></i>';
                    }
                    
                    // CLICK HANDLER: sorts the clicked column in ascending/descending order.
                    header.addEventListener('click', () => {
                        const tbody = table.querySelector('tbody');
                        const rows = Array.from(tbody.querySelectorAll('tr'));
                        // DO NOTHING IF THE TABLE IS EMPTY OR ONLY SHOWS THE EMPTY-STATE ROW.
                        if(rows.length === 0 || rows[0].querySelector('.empty-state')) return;
                        
                        // CHECK CURRENT DIRECTION: if already ascending, the next click switches to descending.
                        const isAsc = header.classList.contains('sort-asc');
                        
                        // RESET ALL HEADER STATES AND ICONS BEFORE APPLYING THE NEW SORT STATE.
                        headers.forEach(h => {
                            h.classList.remove('sort-asc', 'sort-desc');
                            const icon = h.querySelector('i');
                            if(icon) {
                                icon.className = 'fas fa-sort text-muted';
                            }
                        });
                        
                        // dirModifier CONTROLS SORT ORDER: 1 = ascending, -1 = descending.
                        const dirModifier = isAsc ? -1 : 1;
                        if(isAsc) {
                            header.classList.add('sort-desc');
                            header.querySelector('i').className = 'fas fa-sort-down text-primary';
                        } else {
                            header.classList.add('sort-asc');
                            header.querySelector('i').className = 'fas fa-sort-up text-primary';
                        }
                        
                        rows.sort((a, b) => {
                            const aCol = a.querySelectorAll('td')[index].textContent.trim();
                            const bCol = b.querySelectorAll('td')[index].textContent.trim();
                            
                            // TRY NUMERIC COMPARISON FIRST FOR COLUMNS LIKE IDs, COUNTS, OR AMOUNTS.
                            const aNum = parseFloat(aCol.replace(/[^0-9.-]+/g,""));
                            const bNum = parseFloat(bCol.replace(/[^0-9.-]+/g,""));
                            
                            if(!isNaN(aNum) && !isNaN(bNum) && isFinite(aNum) && isFinite(bNum)) {
                                return (aNum - bNum) * dirModifier;
                            }
                            // FALL BACK TO TEXT COMPARISON FOR NORMAL STRING COLUMNS.
                            return aCol.localeCompare(bCol) * dirModifier;
                        });
                        
                        // RE-APPEND ROWS IN THE NEW ORDER TO UPDATE THE VISIBLE TABLE.
                        rows.forEach(row => tbody.appendChild(row));
                    });
                });
            });
            
            // 3. EXPORT TO CSV (Other Metier Basique)
            const headerActionsContainer = document.querySelector('.d-flex.justify-content-between.align-items-center.mb-4');
            if(headerActionsContainer && tables.length > 0) {
                const btnGroup = document.createElement('div');
                btnGroup.className = 'd-flex align-items-center gap-2';
                
                const existingBtn = headerActionsContainer.querySelector('button');
                if(existingBtn) {
                    existingBtn.parentNode.insertBefore(btnGroup, existingBtn);
                    btnGroup.appendChild(existingBtn);
                } else {
                    headerActionsContainer.appendChild(btnGroup);
                }
                
                const csvBtn = document.createElement('button');
                csvBtn.className = 'btn text-light d-flex align-items-center justify-content-center';
                csvBtn.style.background = 'rgba(255, 255, 255, 0.1)';
                csvBtn.style.border = '1px solid rgba(255, 255, 255, 0.2)';
                csvBtn.style.borderRadius = '50px';
                csvBtn.style.padding = '0.5rem 1.2rem';
                csvBtn.style.marginLeft = '10px';
                csvBtn.style.transition = 'all 0.3s ease';
                csvBtn.innerHTML = '<i class="fas fa-file-csv mr-2" style="margin-right: 8px;"></i> Export Data';
                
                csvBtn.onmouseover = () => csvBtn.style.background = 'rgba(255, 255, 255, 0.2)';
                csvBtn.onmouseout = () => csvBtn.style.background = 'rgba(255, 255, 255, 0.1)';
                
                csvBtn.onclick = function() {
                    let csv = [];
                    const table = document.querySelector('.data-table');
                    const rows = table.querySelectorAll('tr');
                    
                    for (let i = 0; i < rows.length; i++) {
                        let row = [], cols = rows[i].querySelectorAll('td, th');
                        let isHeader = i === 0;
                        
                        for (let j = 0; j < cols.length; j++) {
                            const text = cols[j].textContent.trim();
                            if(text.toLowerCase() === 'actions') continue;
                            if(cols[j].querySelector('.btn-icon') || cols[j].querySelector('form')) continue;
                            
                            let data = cols[j].textContent.replace(/(\r\n|\n|\r)/gm, " ").replace(/\s+/g, ' ').trim();
                            data = data.replace(/"/g, '""');
                            row.push('"' + data + '"');
                        }
                        // Avoid adding empty rows if they have action buttons only
                        if(row.length > 0) csv.push(row.join(','));
                    }
                    
                    let csvFile = new Blob([csv.join('\n')], {type: "text/csv;charset=utf-8;"});
                    let downloadLink = document.createElement("a");
                    downloadLink.download = document.title.split('-')[0].trim() + "_Export.csv";
                    downloadLink.href = window.URL.createObjectURL(csvFile);
                    downloadLink.style.display = "none";
                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    document.body.removeChild(downloadLink);
                };
                
                btnGroup.appendChild(csvBtn);
            }
        });
        </script>
        {% endblock %}
    </body>
</html>
